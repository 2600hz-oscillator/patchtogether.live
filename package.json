{
  "name": "patchtogether.live",
  "version": "1.4.0",
  "private": true,
  "description": "A multiplayer browser-native modular synthesizer.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/dsp",
    "packages/server",
    "packages/web",
    "art",
    "e2e"
  ],
  "overrides": {
    "yjs": "^13.6.0"
  },
  "scripts": {
    "dev": "npm run dev -w packages/web",
    "build": "npm run build -w packages/dsp && npm run build -w packages/web",
    "watch:dsp": "npm run watch -w packages/dsp",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint:eslint && npm run lint:shell",
    "lint:eslint": "node scripts/lint/eslint-gate.mjs",
    "lint:shell": "SHELLCHECK_BIN=\"$(bash scripts/lint/install-shellcheck.sh)/shellcheck\" node scripts/lint/shellcheck-gate.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.0",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "pixelmatch": "^6.0.0",
    "svelte-eslint-parser": "^1.8.0",
    "typescript-eslint": "^8.67.0",
    "ws": "^8.18.0"
  }
}
